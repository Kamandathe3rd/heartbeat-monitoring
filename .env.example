# ===== Kafka =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=heartbeats
KAFKA_GROUP_ID=heartbeat-consumer

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=heartbeat_db
POSTGRES_USER=heartbeat_user
POSTGRES_PASSWORD=change_me

# ===== Grafana (optional dashboard) =====
GRAFANA_DB_PASSWORD=change_me_reader
GRAFANA_ADMIN_PASSWORD=change_me_admin


# ===== Email alerts (optional) =====
# Default: Mailpit local inbox (docker compose --profile tools up -d, then http://localhost:8025)
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, plus username + app password
# Disable email: leave SMTP_HOST empty
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=heartbeat-monitor@example.com
ALERT_EMAIL_TO=david@example.com